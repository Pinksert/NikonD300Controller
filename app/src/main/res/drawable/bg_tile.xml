<?xml version="1.0" encoding="utf-8"?>
<!-- 网格里的一块（白平衡模式 / 预设编号）：选中直接换成琥珀描边 + 淡琥珀底 -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#1FFF9F0A">
    <item>
        <selector>
            <item android:state_selected="true">
                <shape android:shape="rectangle">
                    <solid android:color="#1F1606" />
                    <corners android:radius="12dp" />
                    <stroke android:width="1dp" android:color="@color/accent_amber" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/bg_elevated" />
                    <corners android:radius="12dp" />
                    <stroke android:width="1dp" android:color="@color/stroke" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
