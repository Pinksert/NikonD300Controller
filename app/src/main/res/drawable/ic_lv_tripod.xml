<?xml version="1.0" encoding="utf-8"?>
<!--
  三脚架取景模式：相机架在三脚架上。
  对应说明书第 83 页"三脚架"那个小图的构图（相机 + 三条腿）。
  线条风格与 ic_liveview 一致：26×26 视区、1.6 描边、圆头。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="26dp"
    android:height="26dp"
    android:viewportWidth="26"
    android:viewportHeight="26">

    <!-- 整体放大 1.15 倍：画满一点，放在 64dp 的圆钮上才够醒目 -->
    <group
        android:pivotX="13"
        android:pivotY="13"
        android:scaleX="1.15"
        android:scaleY="1.15">

        <!-- 相机机身 -->
        <path
            android:pathData="M8.4,3.2 L17.6,3.2 A1.4,1.4 0 0 1 19,4.6 L19,9.4 A1.4,1.4 0 0 1 17.6,10.8 L8.4,10.8 A1.4,1.4 0 0 1 7,9.4 L7,4.6 A1.4,1.4 0 0 1 8.4,3.2 Z"
            android:strokeColor="#E8EDF4"
            android:strokeWidth="1.6" />

        <!-- 镜头 -->
        <path
            android:pathData="M13,5.1 A1.6,1.6 0 1,1 13,8.3 A1.6,1.6 0 1,1 13,5.1"
            android:strokeColor="#E8EDF4"
            android:strokeWidth="1.4" />

        <!-- 云台柱 -->
        <path
            android:pathData="M13,10.8 L13,12.6"
            android:strokeColor="#E8EDF4"
            android:strokeWidth="1.6"
            android:strokeLineCap="round" />

        <!-- 三条腿 -->
        <path
            android:pathData="M13,12.6 L7.2,22.6"
            android:strokeColor="#E8EDF4"
            android:strokeWidth="1.6"
            android:strokeLineCap="round" />
        <path
            android:pathData="M13,12.6 L18.8,22.6"
            android:strokeColor="#E8EDF4"
            android:strokeWidth="1.6"
            android:strokeLineCap="round" />
        <path
            android:pathData="M13,12.6 L13,21.4"
            android:strokeColor="#E8EDF4"
            android:strokeWidth="1.6"
            android:strokeLineCap="round" />

        <!-- 脚架中段横撑 -->
        <path
            android:pathData="M9.6,18.2 L16.4,18.2"
            android:strokeColor="#E8EDF4"
            android:strokeWidth="1.3"
            android:strokeLineCap="round" />
    </group>
</vector>
