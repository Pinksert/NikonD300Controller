<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.NikonD300Controller" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- ★ 系统状态栏 / 导航栏统一铺相机暗色背景。
             不写死的话 Material3 会用自己的默认配色（紫）去画系统栏：主页面因为
             整块背景自绘看着一样，相册页却顶出一条紫色系统栏，来回切页像两个 App。
             这里写死之后，MainActivity / GalleryActivity 两个窗口都跟主色一致。 -->
        <item name="android:statusBarColor">@color/bg_base</item>
        <item name="android:navigationBarColor">@color/bg_base</item>
        <item name="android:windowBackground">@color/bg_base</item>
    </style>

    <style name="Theme.NikonD300Controller" parent="Base.Theme.NikonD300Controller" />
</resources>
