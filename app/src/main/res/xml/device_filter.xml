<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 尼康 Vendor ID 0x04B0 -> 十进制 1200 -->

    <!-- D300 · MTP/PTP 模式：0x041A = 1050
         USB 描述：Class 06 Imaging / Sub 01 Still Image Capture / Proto 01 PTP
         机身设置路径：设定菜单 → USB → MTP/PTP -->
    <usb-device vendor-id="1200" product-id="1050" />

    <!-- D300 · 大容量存储模式：0x0419 = 1049
         故意保留匹配：相机在错误模式下插上来时 App 仍会被拉起，
         才有机会提示用户去机身切换，否则用户只会看到「毫无反应」。
         代码侧必须拒绝在此 PID 上建立 PTP 连接（见 MainActivity.connectToDevice）。 -->
    <usb-device vendor-id="1200" product-id="1049" />
</resources>
